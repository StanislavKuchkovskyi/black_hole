// geodesic.comp
// -------------
// OpenGL 4.3 Compute Shader – GPU null-geodesic ray-tracer.
//
// Each invocation handles one output pixel.  A 16×16 thread group tiles the
// output image.  For every pixel:
//   1. Compute the view ray direction from the camera UBO.
//   2. Initialise a Ray struct (position + spherical velocities + conserved quantities).
//   3. March the ray step-by-step with Euler integration (simplified RK1 here,
//      see rk4Step below) until:
//        a. The ray enters the Schwarzschild radius → black hole hit (black).
//        b. The ray crosses the equatorial plane inside the accretion disk → disk hit.
//        c. The ray hits a scene object (sphere).
//        d. The ray escapes to ESCAPE_R → background (transparent black).
//   4. Write the resulting RGBA colour to the output image.
//
// Uniform buffer layout (std140):
//   binding 1 → Camera  (position, axes, fov, aspect, moving flag)
//   binding 2 → Disk    (inner radius, outer radius, ring count, thickness)
//   binding 3 → Objects (count + up to 16 spheres with position/radius/colour/mass)

#version 430
layout(local_size_x = 16, local_size_y = 16) in;

// Output image (RGBA8, written pixel by pixel from the compute shader)
layout(binding = 0, rgba8) writeonly uniform image2D outImage;

// Camera uniform buffer – uploaded every frame from the CPU Camera struct.
layout(std140, binding = 1) uniform Camera {
    vec3 camPos;     float _pad0;   // world-space camera position
    vec3 camRight;   float _pad1;   // camera right basis vector
    vec3 camUp;      float _pad2;   // camera up basis vector
    vec3 camForward; float _pad3;   // camera forward (look direction)
    float tanHalfFov;               // tan(fovY / 2) – used for ray direction scaling
    float aspect;                   // width / height – corrects horizontal FOV
    bool moving;                    // true while the user is dragging (reserved for LOD)
    int   _pad4;
} cam;

// Accretion disk parameters
layout(std140, binding = 2) uniform Disk {
    float disk_r1;   // inner radius of the disk (just outside the ISCO)
    float disk_r2;   // outer radius of the disk
    float disk_num;  // number of disk rings (cosmetic)
    float thickness; // padding / thickness value
};

// Scene objects (up to 16 spheres)
layout(std140, binding = 3) uniform Objects {
    int numObjects;              // actual number of objects in the scene
    vec4 objPosRadius[16];       // xyz = world centre, w = radius
    vec4 objColor[16];           // rgba colour of each object
    float  mass[16];             // mass used for future gravitational N-body work
};

// Schwarzschild radius of Sagittarius A* (r_s = 2GM/c², pre-computed in metres)
const float SagA_rs = 1.269e10;
// Affine-parameter step size for the geodesic integrator (metres)
const float D_LAMBDA = 1e7;
// Escape radius – rays that reach this distance from the origin are "at infinity"
const double ESCAPE_R = 1e30;

// Shared globals used to pass intersection data out of interceptObject().
vec4 objectColor = vec4(0.0);  // colour of the last intersected object
vec3 hitCenter   = vec3(0.0);  // world-space centre of the hit object
float hitRadius  = 0.0;        // radius of the hit object

// Ray – stores the full spherical-coordinate state of a photon.
struct Ray {
    float x, y, z;             // Cartesian position (kept in sync with r, theta, phi)
    float r, theta, phi;       // spherical coordinates
    float dr, dtheta, dphi;    // affine-parameter derivatives (velocities)
    float E, L;                // conserved energy and angular momentum
};

// initRay – construct a Ray from a world-space position and normalised direction.
// Converts pos to spherical coordinates and projects dir onto the spherical basis
// to obtain (dr, dtheta, dphi).  Computes conserved quantities E and L.
Ray initRay(vec3 pos, vec3 dir) {
    Ray ray;
    ray.x = pos.x; ray.y = pos.y; ray.z = pos.z;
    ray.r     = length(pos);
    ray.theta = acos(pos.z / ray.r);
    ray.phi   = atan(pos.y, pos.x);

    float dx = dir.x, dy = dir.y, dz = dir.z;
    // Project the Cartesian direction onto the spherical basis vectors:
    ray.dr     = sin(ray.theta)*cos(ray.phi)*dx + sin(ray.theta)*sin(ray.phi)*dy + cos(ray.theta)*dz;
    ray.dtheta = (cos(ray.theta)*cos(ray.phi)*dx + cos(ray.theta)*sin(ray.phi)*dy - sin(ray.theta)*dz) / ray.r;
    ray.dphi   = (-sin(ray.phi)*dx + cos(ray.phi)*dy) / (ray.r * sin(ray.theta));

    // Angular momentum L = r² sin(θ) dφ/dλ
    ray.L = ray.r * ray.r * sin(ray.theta) * ray.dphi;
    // Lapse function f(r) = 1 - r_s/r
    float f = 1.0 - SagA_rs / ray.r;
    // Normalise using the null condition g_{μν} u^μ u^ν = 0 to get dt/dλ
    float dt_dL = sqrt((ray.dr*ray.dr)/f + ray.r*ray.r*(ray.dtheta*ray.dtheta + sin(ray.theta)*sin(ray.theta)*ray.dphi*ray.dphi));
    ray.E = f * dt_dL;

    return ray;
}

// intercept – returns true if the ray is inside the Schwarzschild sphere (event horizon).
bool intercept(Ray ray, float rs) {
    return ray.r <= rs;
}

// interceptObject – returns true if the ray's current position is inside any scene sphere.
// Fills the global hitCenter, hitRadius, and objectColor with the intersected object's data.
bool interceptObject(Ray ray) {
    vec3 P = vec3(ray.x, ray.y, ray.z);
    for (int i = 0; i < numObjects; ++i) {
        vec3 center = objPosRadius[i].xyz;
        float radius = objPosRadius[i].w;
        if (distance(P, center) <= radius) {
            objectColor = objColor[i];
            hitCenter   = center;
            hitRadius   = radius;
            return true;
        }
    }
    return false;
}

// geodesicRHS – right-hand side of the 3-D Schwarzschild null geodesic equations.
// Returns:
//   d1 = (dr/dλ,  dθ/dλ,  dφ/dλ)   – first derivatives
//   d2 = (d²r/dλ², d²θ/dλ², d²φ/dλ²) – second derivatives (accelerations)
//
// Equations derived from the Euler-Lagrange equations of the Schwarzschild metric:
//   d²r/dλ² = -(rs/2r²)·f·(dt/dλ)² + (rs/2r²f)·(dr/dλ)² + r·(dθ² + sin²θ·dφ²)
//   d²θ/dλ² = -2(dr·dθ)/r + sinθ·cosθ·dφ²
//   d²φ/dλ² = -2(dr·dφ)/r - 2(cosθ/sinθ)·dθ·dφ
void geodesicRHS(Ray ray, out vec3 d1, out vec3 d2) {
    float r      = ray.r,     theta  = ray.theta;
    float dr     = ray.dr,    dtheta = ray.dtheta, dphi = ray.dphi;
    float f      = 1.0 - SagA_rs / r;  // lapse function
    float dt_dL  = ray.E / f;          // dt/dλ from conserved energy

    d1 = vec3(dr, dtheta, dphi); // first derivatives

    // Second derivatives (accelerations in spherical coordinates):
    d2.x = - (SagA_rs / (2.0 * r*r)) * f * dt_dL * dt_dL    // gravitational term
           + (SagA_rs / (2.0 * r*r * f)) * dr * dr             // metric correction
           + r * (dtheta*dtheta + sin(theta)*sin(theta)*dphi*dphi); // centrifugal

    d2.y = -2.0*dr*dtheta/r + sin(theta)*cos(theta)*dphi*dphi; // θ Christoffel

    d2.z = -2.0*dr*dphi/r - 2.0*cos(theta)/(sin(theta)) * dtheta * dphi; // φ Christoffel
}

// rk4Step – advances the geodesic state by one affine-parameter step using
// forward-Euler integration (first-order).
//
// NOTE: Despite the function name inherited from the CPU code, this is NOT a
// true 4th-order Runge-Kutta scheme – it uses a single slope evaluation at
// the beginning of the step (Euler method).  Upgrading to true RK4 would
// require four geodesicRHS() evaluations per step:
//   k1 = f(y_n)
//   k2 = f(y_n + h/2 · k1)
//   k3 = f(y_n + h/2 · k2)
//   k4 = f(y_n + h   · k3)
//   y_{n+1} = y_n + (h/6)·(k1 + 2k2 + 2k3 + k4)
// For the step sizes used here (D_LAMBDA = 1e7 m) Euler is sufficient to
// produce visually plausible results.
void rk4Step(inout Ray ray, float dL) {
    vec3 k1a, k1b;
    geodesicRHS(ray, k1a, k1b);

    // Update state: Euler integration y_{n+1} = y_n + h·f(y_n)
    ray.r      += dL * k1a.x;
    ray.theta  += dL * k1a.y;
    ray.phi    += dL * k1a.z;
    ray.dr     += dL * k1b.x;
    ray.dtheta += dL * k1b.y;
    ray.dphi   += dL * k1b.z;

    // Reconstruct Cartesian position from updated spherical coordinates
    ray.x = ray.r * sin(ray.theta) * cos(ray.phi);
    ray.y = ray.r * sin(ray.theta) * sin(ray.phi);
    ray.z = ray.r * cos(ray.theta);
}

// crossesEquatorialPlane – returns true when the ray crosses the plane y = 0
// (equatorial plane) and the crossing point lies within the accretion disk radii.
// Used to detect photons that illuminate the accretion disk.
bool crossesEquatorialPlane(vec3 oldPos, vec3 newPos) {
    bool crossed = (oldPos.y * newPos.y < 0.0); // sign change → plane crossing
    float r = length(vec2(newPos.x, newPos.z)); // radial distance in the x-z plane
    return crossed && (r >= disk_r1 && r <= disk_r2);
}

// Main compute shader entry point – one invocation per output pixel.
void main() {
    // Fixed render resolution (independent of window size in this implementation)
    int WIDTH  = cam.moving ? 200 : 200;
    int HEIGHT = cam.moving ? 150 : 150;

    ivec2 pix = ivec2(gl_GlobalInvocationID.xy);
    if (pix.x >= WIDTH || pix.y >= HEIGHT) return; // discard out-of-bounds threads

    // Compute the view ray direction for this pixel using the camera UBO:
    //   u, v ∈ [-1, 1] in NDC; scaled by aspect ratio and tan(halfFov).
    float u = (2.0 * (pix.x + 0.5) / WIDTH - 1.0) * cam.aspect * cam.tanHalfFov;
    float v = (1.0 - 2.0 * (pix.y + 0.5) / HEIGHT) * cam.tanHalfFov;
    vec3 dir = normalize(u * cam.camRight - v * cam.camUp + cam.camForward);
    Ray ray = initRay(cam.camPos, dir);

    // Initialise output colour and hit flags
    vec4 color = vec4(0.0);
    vec3 prevPos = vec3(ray.x, ray.y, ray.z);
    float lambda = 0.0; // accumulated affine parameter (not used for termination)

    bool hitBlackHole = false;
    bool hitDisk      = false;
    bool hitObject    = false;

    int steps = cam.moving ? 60000 : 60000; // max integration steps

    // Main ray-marching loop: advance the photon step by step.
    for (int i = 0; i < steps; ++i) {
        if (intercept(ray, SagA_rs)) { hitBlackHole = true; break; } // captured

        rk4Step(ray, D_LAMBDA); // advance by one affine-parameter step
        lambda += D_LAMBDA;

        vec3 newPos = vec3(ray.x, ray.y, ray.z);
        if (crossesEquatorialPlane(prevPos, newPos)) { hitDisk = true; break; }  // disk
        if (interceptObject(ray))                    { hitObject = true; break; } // sphere
        prevPos = newPos;
        if (ray.r > ESCAPE_R) break; // escaped to infinity → transparent black
    }

    // Assign colour based on what the ray hit:
    if (hitDisk) {
        // Colour the disk: warm gradient from red-orange (outer) to yellow-white (inner)
        double r = length(vec3(ray.x, ray.y, ray.z)) / disk_r2; // normalised radius
        vec3 diskColor = vec3(1.0, r, 0.2);
        color = vec4(diskColor, r);

    } else if (hitBlackHole) {
        // Event horizon: perfectly black
        color = vec4(0.0, 0.0, 0.0, 1.0);

    } else if (hitObject) {
        // Sphere with simple view-dependent shading (V·N diffuse approximation)
        vec3 P = vec3(ray.x, ray.y, ray.z);
        vec3 N = normalize(P - hitCenter);          // surface normal
        vec3 V = normalize(cam.camPos - P);         // view direction
        float ambient   = 0.1;
        float diff      = max(dot(N, V), 0.0);      // view-angle diffuse (not physically correct but looks ok)
        float intensity = ambient + (1.0 - ambient) * diff;
        vec3 shaded     = objectColor.rgb * intensity;
        color = vec4(shaded, objectColor.a);

    } else {
        // Background / infinity: transparent black (will show through to the grid overlay)
        color = vec4(0.0);
    }

    // Write the final colour to the output image at this pixel's coordinates.
    imageStore(outImage, pix, color);
}
